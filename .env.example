# PALASH MITRA Environment Configuration

# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# Security & Authentication
JWT_SECRET=palash_mitra_sih_secure_jwt_secret_2026_jharkhand
JWT_EXPIRES_IN=7d

# Database Configuration
# Defaults to embedded SQLite for zero-friction standalone run; can point to PostgreSQL
DB_TYPE=sqlite
DB_FILE=./data/palash_mitra.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/palash_mitra

# AI Provider Configuration (Optional Cloud API Keys)
# If no key is provided, the platform seamlessly uses LocalAIProvider + RuleBased fallback
GEMINI_API_KEY=
BHASHINI_API_KEY=
BHASHINI_USER_ID=

# Speech & Latency Calibration
SPEECH_STT_PROVIDER=webspeech
SPEECH_TTS_PROVIDER=webspeech
LATENCY_MEASUREMENT_ENABLED=true

# Content Pack & Offline Storage
CONTENT_PACK_DIR=./data/packs
OFFLINE_CACHE_MAX_AGE_DAYS=30
